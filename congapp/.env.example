# Optional. AccessSJ runs entirely on local mock data until a backend is connected.
# Copy to .env.local and replace the placeholders. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Admin sign-in on the report page. Set these in .env.local. Never commit that file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me
ADMIN_SECRET=replace-with-a-long-random-string
